# AI Doubt Solver - Environment Configuration
# Google Gemini API Key (Server-side ONLY, never expose with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (defaults to gemini-flash-latest with fallback to gemini-3.5-flash / gemini-3.8-flash)
GEMINI_MODEL=gemini-flash-latest

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Node / Proxy Configuration (Optional, handled automatically in cloud sandbox)
# HTTP_PROXY=http://10.100.5.1:8081
# HTTPS_PROXY=http://10.100.5.1:8081
